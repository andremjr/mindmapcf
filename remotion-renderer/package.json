{
  "name": "canvas-narrativo-renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion renderer for Canvas Narrativo JSON exports",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx CanvasNarrativo out/video.mp4 --props=./project.json",
    "render:vertical": "remotion render src/index.tsx CanvasNarrativo out/video-vertical.mp4 --props=./project.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "@remotion/bundler": "4.0.250",
    "@remotion/renderer": "4.0.250",
    "remotion": "4.0.250",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.4"
  }
}
